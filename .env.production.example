# =============================================================================
# BVS Framework — Production Environment Variables
# =============================================================================
# Copy these into Dokploy's environment editor with real values.
# NEVER commit this file with real secrets.
# =============================================================================

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=<generate-a-strong-random-key>
DJANGO_ENV=production
DEBUG=False
ALLOWED_HOSTS=bibliotecavirtual.renascerdosaber.com,backend
CSRF_TRUSTED_ORIGINS=https://bibliotecavirtual.renascerdosaber.com
CORS_ALLOWED_ORIGINS=https://bibliotecavirtual.renascerdosaber.com

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=biblioteca
POSTGRES_USER=biblioteca_user
POSTGRES_PASSWORD=<strong-password>
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Meilisearch ───────────────────────────────────────────────────────────────
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=<strong-random-key>

# ── MinIO / Object Storage ───────────────────────────────────────────────────
USE_MINIO=True
MINIO_ACCESS_KEY=<strong-access-key>
MINIO_SECRET_KEY=<strong-secret-key>
MINIO_BUCKET_NAME=biblioteca
MINIO_ENDPOINT_URL=http://minio:9000

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=/api
API_INTERNAL_URL=http://backend:8000/api

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── PayPal ────────────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=<your-paypal-client-id>
PAYPAL_SECRET=<your-paypal-secret>
PAYPAL_MODE=live

# ── Bank Details ──────────────────────────────────────────────────────────────
BANK_NAME=Banco de Desenvolvimento
BANK_ACCOUNT_NAME=Biblioteca Virtual Renascer
BANK_ACCOUNT_NUMBER=<account-number>
BANK_PIX_KEY=<pix-key>

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=<email-user>
EMAIL_HOST_PASSWORD=<email-password>
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@renascerdosaber.com

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@renascerdosaber.com

# ── Sentry (optional) ────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
