<svg width="1200" height="800" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1a2e;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#16213e;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="1200" height="800" fill="url(#grad1)"/>
  <text x="50%" y="40%" font-family="Arial, sans-serif" font-size="42" font-weight="bold" fill="#ffffff" text-anchor="middle">
    📸 Screenshot Coming Soon
  </text>
  <text x="50%" y="50%" font-family="Arial, sans-serif" font-size="32" fill="#16a34a" text-anchor="middle">
    Personalizador de Temas
  </text>
  <text x="50%" y="60%" font-family="Arial, sans-serif" font-size="18" fill="#ffffff" text-anchor="middle" opacity="0.7">
    6 temas predefinidos con modo oscuro/claro y preview en vivo
  </text>
  <text x="50%" y="70%" font-family="Arial, sans-serif" font-size="16" fill="#16a34a" text-anchor="middle" opacity="0.8">
